<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" styleClass="root" stylesheets="@../../../../styles/Dashboard.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.brainware.simplebankingapp.controller.DashboardController">
    
    <left>
        <VBox spacing="15.0" styleClass="sidebar">
            <children>
                <VBox alignment="CENTER" spacing="5.0">
                    <Label style="-fx-font-size: 45;" text="🏛" /> 
                    <Label styleClass="logo-text" text="SimpleBankingApp" />
                </VBox>
                
                <Region prefHeight="40.0" />

                <Button maxWidth="Infinity" onAction="#showDashboardView" styleClass="nav-btn-white" text="🏠  Dashboard" />
                <Button maxWidth="Infinity" onAction="#showTransferView" styleClass="nav-btn-white" text="🤝  Transaction" />
                <Button maxWidth="Infinity" styleClass="nav-btn-white" text="👤  Accounts" />

                <Line endX="180.0" stroke="#eeeeee" />

                <Button maxWidth="Infinity" styleClass="nav-btn-dark" text="👤  Profile" />
                <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="nav-btn-dark" text="↪  Logout" />

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="10.0" styleClass="report-card">
                    <Label style="-fx-font-weight: bold; -fx-text-fill: #1a2e1a;" text="Report Suggestion/Bug?" wrapText="true" />
                    <Label style="-fx-font-size: 11; -fx-text-fill: #555555;" text="Use this to report any errors or suggestions." wrapText="true" />
                    <Button maxWidth="Infinity" styleClass="report-btn" text="+ Report" />
                </VBox>
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea">
            <children>
                <VBox fx:id="dashboardView" spacing="30.0">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <Label styleClass="section-title" text="Overview" />
                        <HBox spacing="25.0">
                            <children>
                                <VBox prefWidth="350.0" styleClass="balance-card" HBox.hgrow="ALWAYS">
                                    <Label text="Checking Account" textFill="#888888" />
                                    <Label fx:id="checkingBalanceLabel" styleClass="balance-amount" text="\$0.00" />
                                </VBox>
                                <VBox prefWidth="350.0" styleClass="balance-card" HBox.hgrow="ALWAYS">
                                    <Label text="Savings Account" textFill="#888888" />
                                    <Label fx:id="savingsBalanceLabel" styleClass="balance-amount" text="\$0.00" />
                                </VBox>
                            </children>
                        </HBox>

                        <VBox spacing="15.0" styleClass="balance-card" VBox.vgrow="ALWAYS">
                            <Label styleClass="section-title" text="Recent Transactions" />
                            <TableView fx:id="transactionTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colDate" prefWidth="150.0" text="Date" />
                                    <TableColumn fx:id="colDesc" prefWidth="400.0" text="Description" />
                                    <TableColumn fx:id="colAmount" prefWidth="200.0" text="Amount" />
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </StackPane>
    </center>
</BorderPane>
